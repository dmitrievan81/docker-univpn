# Copy to .env and fill in secrets:
#   cp .env.example .env

TZ=Europe/Moscow

# SLK UniVPN gateway
VPN_GATEWAY=vpn.oooslk.ru
VPN_PORT=4443

VPN_USERNAME=your.user@corp.oooslk.ru
VPN_PASSWORD=your-password

# VPN interface name inside the container (max 9 chars)
TUN_DEVICE=cnem_vnic

# DNS inside SOCKS container (shared VPN netns). So names like
# gitlab.oooslk.ru resolve to 192.168.44.x instead of host Amnezia fake-IP.
# Space-separated nameservers; first is preferred.
VPN_DNS=192.168.44.123 192.168.44.70
VPN_DOMAIN=corp.oooslk.ru
